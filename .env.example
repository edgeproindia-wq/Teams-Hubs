# Copy these into Railway / Render "Variables". Never commit real values.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
# Railway: add a PostgreSQL plugin and it creates DATABASE_URL for you
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Optional but needed if you run more than one instance (real-time across instances)
REDIS_URL=
# Optional: turns on the real AI copilot. Without it the copilot uses a basic offline drafter.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: comma separated hosts. Railway/Render domains are added automatically.
ALLOWED_HOSTS=
